{
  "multipart": [
    { "apply": { "model": "berongsmp:block/conference_table_top" } },

    { "when": { "north": "false", "west": "false" }, "apply": { "model": "berongsmp:block/conference_table_leg" } },
    { "when": { "north": "false", "east": "false" }, "apply": { "model": "berongsmp:block/conference_table_leg", "y": 90 } },
    { "when": { "south": "false", "east": "false" }, "apply": { "model": "berongsmp:block/conference_table_leg", "y": 180 } },
    { "when": { "south": "false", "west": "false" }, "apply": { "model": "berongsmp:block/conference_table_leg", "y": 270 } },

    { "when": { "north": "false" }, "apply": { "model": "berongsmp:block/conference_table_stretcher" } },
    { "when": { "east": "false" },  "apply": { "model": "berongsmp:block/conference_table_stretcher", "y": 90 } },
    { "when": { "south": "false" }, "apply": { "model": "berongsmp:block/conference_table_stretcher", "y": 180 } },
    { "when": { "west": "false" },  "apply": { "model": "berongsmp:block/conference_table_stretcher", "y": 270 } },

    { "when": { "north": "false" }, "apply": { "model": "berongsmp:block/conference_table_apron" } },
    { "when": { "east": "false" },  "apply": { "model": "berongsmp:block/conference_table_apron", "y": 90 } },
    { "when": { "south": "false" }, "apply": { "model": "berongsmp:block/conference_table_apron", "y": 180 } },
    { "when": { "west": "false" },  "apply": { "model": "berongsmp:block/conference_table_apron", "y": 270 } }
  ]
}
