{
  "multipart": [
    { "apply": { "model": "berongsmp:block/table_base" } },

    { "when": { "north": "false" }, "apply": { "model": "berongsmp:block/table_apron" } },
    { "when": { "east": "false" },  "apply": { "model": "berongsmp:block/table_apron", "y": 90 } },
    { "when": { "south": "false" }, "apply": { "model": "berongsmp:block/table_apron", "y": 180 } },
    { "when": { "west": "false" },  "apply": { "model": "berongsmp:block/table_apron", "y": 270 } }
  ]
}
